# ==============================================================================
# ORCHESTRIX Platform Environment Configuration
# ==============================================================================

# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=indiawin
POSTGRES_DB=orchestrix_db

# GroqCloud Cloud LLM Integration (Recommended for Cloud Deployments)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Local LLM Engine (Ollama - used if GROQ_API_KEY is unset)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Networking & Endpoints
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
