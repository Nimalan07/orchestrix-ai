APP_NAME=Orchestrix
APP_VERSION=0.1.0
DEBUG=True
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/orchestrix_db

# GroqCloud Configuration (Optional - provides blazing fast cloud inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama Configuration (Fallback if GROQ_API_KEY is not provided)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
FRONTEND_URL=http://localhost:3000
